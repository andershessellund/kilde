{
  "name": "kilde",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "author": "Anders Hessellund Jensen",
  "description": "Signals, streams, and channels for JavaScript \u2014 synchronous reactivity, backpressured push streams, CSP-style coordination, and async state, with pluggable ownership. No dependencies.",
  "keywords": [
    "signals",
    "reactive",
    "streams",
    "backpressure",
    "channels",
    "csp",
    "select",
    "async state",
    "computed",
    "store"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andershessellund/kilde.git"
  },
  "bugs": "https://github.com/andershessellund/kilde/issues",
  "homepage": "https://github.com/andershessellund/kilde#readme",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./valsem": {
      "types": "./dist/valsem.d.ts",
      "default": "./dist/valsem.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.tests.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.32.0",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "stifinder": "^0.0.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "valsem": "^0.0.4",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "stifinder": "^0.0.1",
    "valsem": "^0.0.4"
  },
  "peerDependenciesMeta": {
    "stifinder": {
      "optional": true
    },
    "valsem": {
      "optional": true
    }
  }
}
