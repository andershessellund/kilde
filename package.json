{
  "name": "kilde",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "author": "Anders Hessellund Jensen",
  "description": "Signals, streams, and channels for JavaScript — synchronous reactivity, backpressured push streams, CSP-style coordination, and async state, with pluggable ownership. No dependencies.",
  "keywords": [
    "signals",
    "reactive",
    "streams",
    "backpressure",
    "channels",
    "csp",
    "select",
    "async state",
    "computed",
    "store"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andershessellund/kilde.git"
  },
  "bugs": "https://github.com/andershessellund/kilde/issues",
  "homepage": "https://github.com/andershessellund/kilde#readme",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./valsem": {
      "types": "./dist/valsem.d.ts",
      "default": "./dist/valsem.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.tests.json",
    "check:package": "publint --strict && attw --pack . --profile esm-only",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.5.1",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@conventional-commits/parser": "0.4.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "publint": "^0.3.24",
    "stifinder": "^0.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "valsem": "^0.1.0",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "stifinder": "^0.2.0",
    "valsem": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "stifinder": {
      "optional": true
    },
    "valsem": {
      "optional": true
    }
  }
}
